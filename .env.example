# Copy to .env and fill in. Nothing here is needed for `ingest` (RSS), `stats`,
# `price-event`, or `ask --no-synth` — those run keyless. Add keys only for the
# features you want. The keyless RSS news feeds are the default content workhorse.

# --- Required for `ask` synthesis (the full, cited answer) ---
ANTHROPIC_API_KEY=            # console.anthropic.com -> API keys. Used by synthesize.py.
                              # Without it, `ask --no-synth` still shows the evidence.

# --- Optional: CoinMarketCap connector (in the default source set) ---
CMC_API_KEY=                  # coinmarketcap.com/api -> enables CMCConnector.
                              # NOTE: /v1/content/latest is a PAID-plan endpoint;
                              # a free "Basic" key fails soft with a logged notice.

# --- Optional: Reddit (opt-in via `--sources reddit`; needs a "script" app) ---
REDDIT_CLIENT_ID=             # reddit.com/prefs/apps -> create a "script" app
REDDIT_CLIENT_SECRET=         #   (same page, under the app)
REDDIT_USER_AGENT=crypto-intel/0.1 by u/<your_reddit_username>

# --- Optional ---
# NEWSAPI_KEY=                # only if you swap an RSS news feed for newsapi.org

# --- Config (have sensible defaults; override only if needed) ---
CHROMA_PATH=data/store/chroma
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_BACKEND=onnx            # onnx (default, torch-free) | sentence-transformers
                             #   sentence-transformers needs: pip install -e .[st]
STORE_BACKEND=chroma          # chroma (default, embedded) | pgvector (Postgres/Supabase)
# DATABASE_URL=              # Postgres DSN, required when STORE_BACKEND=pgvector
                             #   e.g. postgresql://user:pass@host:5432/db  (needs pip install -e .[pg])
SYNTH_MODEL=claude-sonnet-5
DEFAULT_LOOKBACK_HOURS=48
DEFAULT_K=6
